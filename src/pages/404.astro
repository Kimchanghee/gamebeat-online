---
import Base from '../layouts/Base.astro';
import { graph, organization } from '../lib/ld.ts';
---
<Base title="Page Not Found: Return to the Gear Bench | GameBeat" description="This GameBeat page could not be found. Return to the gear bench, browse sourced buying guides or check the equipment categories to find the right setup advice." path="/404/" ld={graph(organization())}>
  <div class="wrap void">
    <p class="void__stamp">NOT FOUND</p>
    <h1>This station is empty.</h1>
    <p>The address you followed does not match any checklist or pick.</p>
    <ul><li><a href="/">Back to the gear bench</a></li><li><a href="/guides/">All buying checklists</a></li><li><a href="/picks/">Product picks</a></li></ul>
  </div>
</Base>
